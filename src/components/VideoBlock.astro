---
import { withBase } from "../lib/paths";

interface Props {
  src?: string;
  youtube?: string;
  poster: string;
  caption?: string;
  orientation?: "portrait" | "landscape";
}

const { src, youtube, poster, caption, orientation = "landscape" } = Astro.props;
const portrait = orientation === "portrait";
---

<figure class="min-w-0">
  <div
    class:list={[
      "video-shell overflow-hidden rounded-2xl ring-1 ring-line",
      portrait && !youtube ? "mx-auto max-w-[320px] phone-frame" : "",
      youtube ? "aspect-video" : "",
    ]}
  >
    {
      youtube ? (
        <iframe
          class="h-full w-full"
          src={`https://www.youtube-nocookie.com/embed/${youtube}`}
          title={caption ?? "Gameplay video"}
          allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
          referrerpolicy="strict-origin-when-cross-origin"
          allowfullscreen
          loading="lazy"
        />
      ) : (
        src && (
          <video
            class:list={[portrait ? "h-full w-full object-cover" : "h-auto w-full"]}
            controls
            playsinline
            preload="metadata"
            poster={withBase(poster)}
            src={withBase(src)}
          />
        )
      )
    }
  </div>
  {
    caption && (
      <figcaption class="mt-3 text-sm text-muted">{caption}</figcaption>
    )
  }
</figure>
