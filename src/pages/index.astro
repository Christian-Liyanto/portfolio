---
import { getCollection } from "astro:content";
import Base from "../layouts/Base.astro";
import VideoBlock from "../components/VideoBlock.astro";
import { withBase } from "../lib/paths";

const projects = (await getCollection("projects")).sort(
  (a, b) => a.data.order - b.data.order,
);
const featured = projects.filter((p) => p.data.featured);
const rest = projects.filter((p) => !p.data.featured);
---

<Base title="Christian Liyanto — Gameplay developer">
  <main id="main">
    <section class="mx-auto grid max-w-6xl gap-10 px-5 py-16 lg:grid-cols-[1.15fr_0.85fr] lg:items-center lg:py-24">
      <div>
        <p class="text-sm font-medium uppercase tracking-[0.2em] text-accent">
          Gameplay developer
        </p>
        <h1 class="mt-4 font-display text-5xl leading-[1.05] text-paper sm:text-6xl">
          I ship the systems players actually touch.
        </h1>
        <p class="mt-6 max-w-xl text-lg leading-relaxed text-muted">
          Combat, quests, idle loops, and the awkward glue between a game engine
          and a platform — mobile, a Reddit post, or a panel on X.
        </p>
        <div class="mt-8 flex flex-wrap gap-3">
          <a
            href="#work"
            class="rounded-full bg-accent px-5 py-2.5 text-sm font-medium text-ink hover:brightness-110"
          >
            See the work
          </a>
          <a
            href="mailto:christianliyanto@gmail.com"
            class="rounded-full border border-line px-5 py-2.5 text-sm text-paper hover:border-muted"
          >
            Email me
          </a>
        </div>
      </div>
      <div class="hidden justify-end lg:flex">
        <div class="phone-frame w-[280px] overflow-hidden rounded-[2rem] ring-1 ring-line">
          <img
            src={withBase("images/meowquest.jpg")}
            alt="MeowQuest title screen: a round cat with a sword on a cliff"
            class="h-full w-full object-cover"
          />
        </div>
      </div>
    </section>

    <section id="work" class="border-t border-line">
      <div class="mx-auto max-w-6xl px-5 py-16">
        <p class="text-sm uppercase tracking-[0.2em] text-muted">Selected work</p>
        <h2 class="mt-2 font-display text-3xl">Projects I was responsible for</h2>
        <p class="mt-3 max-w-2xl text-muted">
          Gameplay captures from the titles I shipped systems on.
        </p>

        <div class="mt-12 space-y-20">
          {
            featured.map((project) => (
              <article class="grid gap-8 lg:grid-cols-12 lg:items-start">
                <div class="lg:col-span-4">
                  <p class="text-sm text-muted">
                    {project.data.year} · {project.data.kind}
                  </p>
                  <h3 class="mt-1 font-display text-3xl">{project.data.title}</h3>
                  <p class="mt-3 text-muted">{project.data.tagline}</p>
                  <p class="mt-3 text-sm text-accent">{project.data.role}</p>
                  <ul class="mt-4 flex flex-wrap gap-2">
                    {project.data.stack.slice(0, 5).map((tag) => (
                      <li class="rounded-full border border-line px-3 py-1 text-xs text-muted">
                        {tag}
                      </li>
                    ))}
                  </ul>
                  <a
                    class="mt-6 inline-flex text-sm text-paper underline decoration-line underline-offset-4 hover:decoration-accent"
                    href={withBase(`projects/${project.id}/`)}
                  >
                    Case study
                  </a>
                </div>
                <div
                  class:list={[
                    "lg:col-span-8",
                    project.data.orientation === "portrait"
                      ? "grid gap-4 sm:grid-cols-2"
                      : "grid gap-4",
                  ]}
                >
                  {project.data.videos.map((video) => (
                    <VideoBlock
                      src={video.src}
                      youtube={video.youtube}
                      poster={video.poster}
                      caption={video.caption}
                      orientation={project.data.orientation}
                    />
                  ))}
                </div>
              </article>
            ))
          }
        </div>

        {
          rest.length > 0 && (
            <div class="mt-20">
              <h3 class="font-display text-2xl">Also</h3>
              <div class="mt-6 grid gap-6 sm:grid-cols-2">
                {rest.map((project) => (
                  <a
                    href={withBase(`projects/${project.id}/`)}
                    class="group overflow-hidden rounded-2xl ring-1 ring-line hover:ring-muted"
                  >
                    <img
                      src={withBase(project.data.poster)}
                      alt=""
                      class="aspect-video w-full object-cover"
                    />
                    <div class="p-5">
                      <p class="text-sm text-muted">{project.data.year}</p>
                      <h4 class="mt-1 font-display text-xl group-hover:text-accent">
                        {project.data.title}
                      </h4>
                      <p class="mt-2 text-sm text-muted">{project.data.tagline}</p>
                    </div>
                  </a>
                ))}
              </div>
            </div>
          )
        }
      </div>
    </section>

    <section id="about" class="border-t border-line">
      <div class="mx-auto grid max-w-6xl gap-10 px-5 py-16 lg:grid-cols-2">
        <div>
          <p class="text-sm uppercase tracking-[0.2em] text-muted">About</p>
          <h2 class="mt-2 font-display text-3xl">Christian Liyanto</h2>
          <div class="mt-5 space-y-4 text-muted leading-relaxed">
            <p>
              I am a game developer studying at Universitas Multimedia Nusantara. Most of
              my time goes into the player-facing layer: the fight, the day
              counter, the shop on a sidebar, the word you just invented.
            </p>
            <p>
              Recent work started as an intern on a 3D creature-hunt RPG, then a
              hybrid casual island adventure, a mobile cat idle RPG, an idle pet
              on X, and a Unity WebGL word-crafting game inside Reddit.
            </p>
          </div>
        </div>
        <div class="rounded-2xl border border-line bg-ink-2 p-6">
          <h3 class="font-display text-xl">What I reach for</h3>
          <dl class="mt-5 grid grid-cols-2 gap-x-6 gap-y-4 text-sm">
            <div>
              <dt class="text-muted">Engine</dt>
              <dd>Unity, C#</dd>
            </div>
            <div>
              <dt class="text-muted">Platforms</dt>
              <dd>Mobile, Windows, WebGL, browser extensions</dd>
            </div>
            <div>
              <dt class="text-muted">Web</dt>
              <dd>JavaScript, TypeScript, React</dd>
            </div>
            <div>
              <dt class="text-muted">Client glue</dt>
              <dd>Reddit WebGL, X overlays</dd>
            </div>
          </dl>
        </div>
      </div>
    </section>

    <section id="contact" class="border-t border-line">
      <div class="mx-auto max-w-6xl px-5 py-16">
        <p class="text-sm uppercase tracking-[0.2em] text-muted">Contact</p>
        <h2 class="mt-2 font-display text-3xl">Want to look at a build together?</h2>
        <p class="mt-4 max-w-xl text-muted">
          I am available for gameplay, Unity, and client-side game work.
        </p>
        <div class="mt-8 flex flex-wrap gap-4 text-sm">
          <a
            class="rounded-full bg-accent px-5 py-2.5 font-medium text-ink hover:brightness-110"
            href="mailto:christianliyanto@gmail.com"
          >
            christianliyanto@gmail.com
          </a>
          <a
            class="rounded-full border border-line px-5 py-2.5 hover:border-muted"
            href="https://github.com/Christian-Liyanto"
            target="_blank"
            rel="noreferrer"
          >
            GitHub
          </a>
        </div>
      </div>
    </section>
  </main>
</Base>
