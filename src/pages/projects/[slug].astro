---
import { getCollection, render } from "astro:content";
import Base from "../../layouts/Base.astro";
import VideoBlock from "../../components/VideoBlock.astro";
import { withBase } from "../../lib/paths";

export async function getStaticPaths() {
  const projects = await getCollection("projects");
  return projects.map((project) => ({
    params: { slug: project.id },
    props: { project },
  }));
}

const { project } = Astro.props;
const { Content } = await render(project);
---

<Base
  title={`${project.data.title} — Christian Liyanto`}
  description={project.data.tagline}
  image={project.data.poster}
>
  <main id="main" class="mx-auto max-w-6xl px-5 py-16">
    <p class="text-sm text-muted">
      <a class="hover:text-paper" href={withBase("")}>Home</a>
      <span class="px-2">/</span>
      {project.data.title}
    </p>
    <p class="mt-6 text-sm uppercase tracking-[0.2em] text-accent">
      {project.data.year} · {project.data.kind}
    </p>
    <h1 class="mt-3 font-display text-5xl leading-tight">{project.data.title}</h1>
    <p class="mt-4 max-w-2xl text-lg text-muted">{project.data.tagline}</p>
    <p class="mt-3 text-sm text-paper">{project.data.role}</p>

    <ul class="mt-6 flex flex-wrap gap-2">
      {
        project.data.stack.map((tag) => (
          <li class="rounded-full border border-line px-3 py-1 text-xs text-muted">
            {tag}
          </li>
        ))
      }
    </ul>

    {
      project.data.links.length > 0 && (
        <div class="mt-6 flex flex-wrap gap-3">
          {project.data.links.map((link) => (
            <a
              class="rounded-full border border-line px-4 py-2 text-sm hover:border-muted"
              href={link.href}
              target="_blank"
              rel="noreferrer"
            >
              {link.label}
            </a>
          ))}
        </div>
      )
    }

    {
      project.data.videos.length > 0 && (
        <div
          class:list={[
            "mt-12",
            project.data.orientation === "portrait"
              ? "grid gap-6 sm:grid-cols-2"
              : "grid gap-8",
          ]}
        >
          {project.data.videos.map((video) => (
            <VideoBlock
              src={video.src}
              poster={video.poster}
              caption={video.caption}
              orientation={project.data.orientation}
            />
          ))}
        </div>
      )
    }

    {
      project.data.videos.length === 0 && (
        <img
          class="mt-12 w-full rounded-2xl ring-1 ring-line"
          src={withBase(project.data.poster)}
          alt=""
        />
      )
    }

    <article
      class="prose mt-12 max-w-2xl space-y-4 text-muted [&_a]:text-paper [&_a]:underline [&_a]:decoration-line [&_a]:underline-offset-4 [&_strong]:text-paper [&_h1]:hidden [&_li]:ml-5 [&_li]:list-disc"
    >
      <Content />
    </article>
  </main>
</Base>
