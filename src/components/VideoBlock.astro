---
import { withBase } from "../lib/paths";

interface Props {
  src: string;
  poster: string;
  caption?: string;
  orientation?: "portrait" | "landscape";
}

const { src, poster, caption, orientation = "landscape" } = Astro.props;
const portrait = orientation === "portrait";
---

<figure class="min-w-0">
  <div
    class:list={[
      "video-shell overflow-hidden rounded-2xl ring-1 ring-line",
      portrait ? "mx-auto max-w-[320px] phone-frame" : "",
    ]}
  >
    <video
      class:list={[portrait ? "h-full w-full object-cover" : "h-auto w-full"]}
      controls
      playsinline
      preload="metadata"
      poster={withBase(poster)}
      src={withBase(src)}
    >
    </video>
  </div>
  {
    caption && (
      <figcaption class="mt-3 text-sm text-muted">{caption}</figcaption>
    )
  }
</figure>
